# ==============================================================================
# DukaanOS Backend Environment Configuration Example
# Copy this file to backend/.env and configure your production values.
# NEVER commit real production secrets, passwords, or .env files to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Persistent Relational Database)
# ------------------------------------------------------------------------------
# Production MySQL 8.0:
DATABASE_URL=mysql+pymysql://dukaanos_user:YOUR_STRONG_DATABASE_PASSWORD@localhost:3306/dukaanos_db

# Managed PostgreSQL (e.g. AWS RDS, DigitalOcean, Supabase):
# DATABASE_URL=postgresql://dukaanos_user:YOUR_STRONG_DATABASE_PASSWORD@localhost:5432/dukaanos_db

# Local SQLite (Development fallback only - do NOT use SQLite for multi-worker production):
# DATABASE_URL=sqlite:///./dukaanos.db

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-char key in terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_YOUR_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 3. CORS ACCESS CONTROL
# ------------------------------------------------------------------------------
# Strict list of allowed frontend domains (Comma-separated).
# Wildcard '*' is strictly rejected when ENVIRONMENT=production!
CORS_ORIGINS=https://yourstore.com,https://admin.yourstore.com

# ------------------------------------------------------------------------------
# 4. BRUTE FORCE RATE LIMITING
# ------------------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
# Set to 'production' to enforce strict security checks and disable demo fixtures
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
