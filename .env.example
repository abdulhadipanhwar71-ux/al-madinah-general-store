# ==============================================================================
# DukaanOS Frontend Environment Configuration Example
# Copy this file to .env.production or .env.local for custom deployment settings.
# ==============================================================================

# Backend API URL (Optional)
# - Leave empty ("") if frontend and backend share the same domain via reverse proxy (/api)
# - Set to full HTTPS URL for separated deployments (e.g., Cloudflare Pages frontend + VPS backend):
# VITE_API_URL=https://api.yourdomain.pk
VITE_API_URL=

# Demo Mode Toggle on /admin/login
# - Set to "false" in production to hide demo credentials and demo role selectors
# - Set to "true" in development to enable 1-click test logins
VITE_ENABLE_DEMO_LOGIN=false
